+// Copyright (c) 2026
+// Use of this source code is governed by a GPLv3 license that can be found in the LICENSE file.
+//
+// Native FluidNC ATC for a linear bed-mounted OpenATC magazine.
+
+#pragma once
+
+#include "Config.h"
+
+#include "Configuration/Configurable.h"
+#include "Machine/InputPin.h"
+#include "atc.h"
+#include "atc_openatc_model.h"
+
+#include <string>
+#include <vector>
+
+namespace ATCs {
+    class OpenATCJobChannel;
+
+    class OpenATCActionSection : public Configuration::Configurable {
+    public:
+        std::string             direction_name   = "cw";
+        uint32_t                spindle_rpm      = 0;
+        uint32_t                spin_ms          = 0;
+        OpenATCSpindleDirection parsed_direction = OpenATCSpindleDirection::CW;
+
+        void validate() override;
+        void afterParse() override;
+        void group(Configuration::HandlerBase& handler) override;
+
+        virtual OpenATCActionConfig view() const;
+    };
+
+    class OpenATCLoadActionSection : public OpenATCActionSection {
+    public:
+        uint32_t passes                    = 1;
+        float    retract_between_passes_mm = 0.0f;
+
+        void group(Configuration::HandlerBase& handler) override;
+        OpenATCActionConfig view() const override;
+    };
+
+    class OpenATC : public ATC {
+    public:
+        OpenATC(const char* name) : ATC(name) {}
+
+        OpenATC(const OpenATC&)            = delete;
+        OpenATC(OpenATC&&)                 = delete;
+        OpenATC& operator=(const OpenATC&) = delete;
+        OpenATC& operator=(OpenATC&&)      = delete;
+
+        ~OpenATC() override;
+
+        void init() override;
+        void probe_notification() override;
+        bool tool_change(tool_t value, bool pre_select, bool set_tool) override;
+        void validate() override;
+        void afterParse() override;
+        void group(Configuration::HandlerBase& handler) override;
+
+    private:
+        std::string        _layout               = "linear";
+        std::string        _magazine_axis        = "x";
+        axis_t             _parsed_magazine_axis = X_AXIS;
+        uint32_t           _pocket_count         = 0;
+        std::vector<float> _first_pocket_mpos_mm = { 0.0f, 0.0f };
+        float              _pocket_pitch_mm      = 0.0f;
+
+        float _safe_z_mpos_mm          = 0.0f;
+        float _engage_z_mpos_mm        = 0.0f;
+        float _travel_feed_mm_per_min  = 0.0f;
+        float _engage_feed_mm_per_min  = 0.0f;
+        float _retract_feed_mm_per_min = 0.0f;
+
+        OpenATCLoadActionSection* _load   = nullptr;
+        OpenATCActionSection*     _unload = nullptr;
+
+        std::vector<float> _toolsetter_mpos_mm         = { 0.0f, 0.0f, 0.0f };
+        float              _toolsetter_rapid_z_mpos_mm = 0.0f;
+        float              _probe_seek_rate_mm_per_min = 0.0f;
+        float              _probe_feed_rate_mm_per_min = 0.0f;
+        float              _probe_retract_mm           = 0.0f;
+
+        InputPin _tool_in_spindle_pin { "tool_in_spindle_pin" };
+        InputPin _pocket_tool_present_pin { "pocket_tool_present_pin" };
+        InputPin _collet_clear_pin { "collet_clear_pin" };
+
+        bool _have_reference_probe = false;
+
+        OpenATCActionConfig _load_view;
+        OpenATCActionConfig _unload_view;
+
+        void                refresh_action_views();
+        OpenATCConfigView   config_view() const;
+        OpenATCBounds       machine_bounds() const;
+        bool                required_axes_homed() const;
+        bool                validate_runtime(tool_t requested_tool, bool allow_zero);
+        bool                validate_spindle_direction(OpenATCActionSection const& action);
+        bool                check_sensor(InputPin& pin, bool expected, const char* label);
+        bool                check_initial_sensors(tool_t requested_tool);
+        bool                fail_validation(const char* message);
+        void                configure_sensor(InputPin& pin);
+        void                finish_tool_change(tool_t tool, bool have_reference_probe);
+        void                fail_tool_change(const char* message);
+        OpenATCSensorSnapshot sensor_snapshot() const;
+        void                set_current_tool(tool_t tool);
+
+        friend class OpenATCJobChannel;
+    };
+
+}
diff --git a/FluidNC/src/ToolChangers/atc_openatc_job.h b/FluidNC/src/ToolChangers/atc_openatc_job.h
new file mode 100644
index 0000000..131d6c5
--- /dev/null
+++ b/FluidNC/src/ToolChangers/atc_openatc_job.h
@@ -0,0 +1,327 @@
+// Copyright (c) 2026
+// Use of this source code is governed by a GPLv3 license that can be found in the LICENSE file.
+//
+// OpenATC phase sequencer shared by the native FluidNC channel and unit tests.
+
+#pragma once
+
+#include "Error.h"
+#include "Types.h"
+#include "atc_openatc_model.h"
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace ATCs {
+    static constexpr size_t OpenATCNoLineIndex = std::numeric_limits<size_t>::max();
+
+    struct OpenATCLineSink {
+        std::vector<std::string> lines;
+
+        void addf(const char* format, ...) {
+            char    buffer[160];
+            va_list args;
+            va_start(args, format);
+            std::vsnprintf(buffer, sizeof(buffer), format, args);
+            va_end(args);
+            lines.emplace_back(buffer);
+        }
+    };
+
+    template <typename Owner>
+    class OpenATCJobSequencer {
+    public:
+        OpenATCJobSequencer(Owner* owner,
+                            OpenATCChangePlan const& plan,
+                            axis_t magazine_axis,
+                            tool_t starting_tool,
+                            tool_t requested_tool,
+                            bool was_inch_mode)
+            : _owner(owner),
+              _plan(plan),
+              _magazine_axis(magazine_axis),
+              _starting_tool(starting_tool),
+              _requested_tool(requested_tool),
+              _was_inch_mode(was_inch_mode) {
+            queue_current_phase();
+        }
+
+        Error pollLine(char* line, size_t max_line, size_t& line_number) {
+            if (line == nullptr || max_line == 0) {
+                return Error::NoData;
+            }
+            if (_failed) {
+                return Error::GcodeValueWordInvalid;
+            }
+
+            while (_line_index >= _lines.size()) {
+                if (_step_index >= _plan.count) {
+                    finish_success_once();
+                    return Error::Eof;
+                }
+                queue_current_phase();
+                if (_lines.empty()) {
+                    ++_step_index;
+                }
+            }
+
+            std::string const& next = _lines[_line_index++];
+            if (next.size() >= max_line) {
+                if (_was_inch_mode && !_units_restored) {
+                    queue_unit_restore_before_failure("generated line is too long");
+                    return Error::NoData;
+                }
+                fail_job_now("generated line is too long");
+                return Error::LineLengthExceeded;
+            }
+
+            std::strncpy(line, next.c_str(), max_line);
+            line[max_line - 1] = '\0';
+            ++line_number;
+            return Error::Ok;
+        }
+
+        void ack(Error status) {
+            size_t acknowledged_index = _line_index == 0 ? OpenATCNoLineIndex : _line_index - 1;
+            if (status != Error::Ok) {
+                if (_unit_restore_line_index != OpenATCNoLineIndex && acknowledged_index == _unit_restore_line_index) {
+                    fail_job_now("unit restore failed");
+                    return;
+                }
+                fail_job("generated line failed");
+                return;
+            }
+
+            if (_unit_restore_line_index != OpenATCNoLineIndex && acknowledged_index == _unit_restore_line_index) {
+                _units_restored = true;
+                _unit_restore_line_index = OpenATCNoLineIndex;
+            }
+
+            if (!phase_complete_after_ack()) {
+                return;
+            }
+
+            if (_pending_failure != nullptr) {
+                fail_job_now(_pending_failure);
+                return;
+            }
+
+            OpenATCPlanStep completed = _plan.steps[_step_index];
+            if (completed == OpenATCPlanStep::UnloadCurrent && !check_after_unload_or_queue_retry()) {
+                return;
+            }
+            if (completed == OpenATCPlanStep::LoadRequested && !check_after_load()) {
+                return;
+            }
+
+            ++_step_index;
+            _lines.clear();
+            _line_index = 0;
+        }
+
+    private:
+        Owner*                  _owner = nullptr;
+        OpenATCChangePlan       _plan;
+        axis_t                  _magazine_axis = X_AXIS;
+        tool_t                  _starting_tool = 0;
+        tool_t                  _requested_tool = 0;
+        size_t                  _step_index = 0;
+        size_t                  _line_index = 0;
+        bool                    _unload_retry_used = false;
+        bool                    _failed = false;
+        bool                    _finished = false;
+        bool                    _was_inch_mode = false;
+        bool                    _units_restored = false;
+        size_t                  _unit_restore_line_index = OpenATCNoLineIndex;
+        const char*             _pending_failure = nullptr;
+        std::vector<std::string> _lines;
+
+        void queue_current_phase() {
+            _lines.clear();
+            _line_index = 0;
+            _unit_restore_line_index = OpenATCNoLineIndex;
+
+            if (_step_index >= _plan.count || _owner == nullptr) {
+                return;
+            }
+
+            OpenATCLineSink sink;
+            OpenATCConfigView cfg = _owner->openatc_config_view();
+            switch (_plan.steps[_step_index]) {
+                case OpenATCPlanStep::ProbeReference:
+                    openatc_add_reference_probe(sink, cfg);
+                    break;
+                case OpenATCPlanStep::UnloadCurrent:
+                    openatc_add_unload(sink, cfg, _magazine_axis, _starting_tool);
+                    break;
+                case OpenATCPlanStep::LoadRequested:
+                    openatc_add_load(sink, cfg, _magazine_axis, _requested_tool);
+                    break;
+                case OpenATCPlanStep::ProbeRequestedAndApplyTlo:
+                    openatc_add_tool_probe_and_tlo(sink, cfg);
+                    break;
+                case OpenATCPlanStep::ClearTlo:
+                    openatc_add_clear_tlo(sink);
+                    break;
+            }
+
+            if (_step_index == 0 && _was_inch_mode) {
+                sink.lines.insert(sink.lines.begin(), "G21");
+            }
+            if ((_step_index + 1) >= _plan.count && _was_inch_mode) {
+                _unit_restore_line_index = sink.lines.size();
+                sink.addf("G20");
+            }
+            _lines.swap(sink.lines);
+        }
+
+        bool phase_complete_after_ack() const { return _line_index >= _lines.size(); }
+
+        void replace_with_retry_phase() {
+            OpenATCLineSink retry;
+            openatc_add_failed_unload_retry(retry, _owner->openatc_config_view());
+            _lines.swap(retry.lines);
+            _line_index = 0;
+        }
+
+        bool check_after_unload_or_queue_retry() {
+            OpenATCSensorDecision decision = openatc_decide_after_unload(_owner->openatc_sensor_snapshot(), !_unload_retry_used);
+            if (decision == OpenATCSensorDecision::Pass) {
+                return true;
+            }
+            if (decision == OpenATCSensorDecision::RetryUnload) {
+                _unload_retry_used = true;
+                replace_with_retry_phase();
+                return false;
+            }
+            fail_job("failed unload sensor check");
+            return false;
+        }
+
+        bool check_after_load() {
+            if (openatc_decide_after_load(_owner->openatc_sensor_snapshot())) {
+                return true;
+            }
+            fail_job("failed load sensor check");
+            return false;
+        }
+
+        void finish_success_once() {
+            if (_finished || _owner == nullptr) {
+                return;
+            }
+            _finished = true;
+            _owner->openatc_finish_tool_change(_requested_tool, _plan.reference_after);
+        }
+
+        void fail_job_now(const char* message) {
+            if (_failed) {
+                return;
+            }
+            _failed = true;
+            if (_owner != nullptr) {
+                _owner->openatc_fail_tool_change(message);
+            }
+        }
+
+        void queue_unit_restore_before_failure(const char* message) {
+            _pending_failure = message;
+            _lines.clear();
+            _lines.emplace_back("G20");
+            _line_index = 0;
+            _unit_restore_line_index = 0;
+        }
+
+        void fail_job(const char* message) {
+            if (_was_inch_mode && !_units_restored) {
+                queue_unit_restore_before_failure(message);
+                return;
+            }
+            fail_job_now(message);
+        }
+    };
+
+#ifdef UNIT_TEST
+    struct OpenATCJobTestResult {
+        std::vector<std::string> emitted_lines;
+        bool                     finished = false;
+        tool_t                   finished_tool = 0;
+        bool                     have_reference_probe = false;
+        bool                     failed = false;
+        size_t                   failure_count = 0;
+    };
+
+    struct OpenATCJobTestOwner {
+        OpenATCConfigView                  config;
+        std::vector<OpenATCSensorSnapshot> sensor_snapshots;
+        size_t                             sensor_index = 0;
+        bool                               finished = false;
+        tool_t                             finished_tool = 0;
+        bool                               have_reference_probe = false;
+        bool                               failed = false;
+        size_t                             failure_count = 0;
+
+        OpenATCConfigView openatc_config_view() const { return config; }
+
+        OpenATCSensorSnapshot openatc_sensor_snapshot() {
+            if (sensor_index >= sensor_snapshots.size()) {
+                return OpenATCSensorSnapshot {};
+            }
+            return sensor_snapshots[sensor_index++];
+        }
+
+        void openatc_finish_tool_change(tool_t tool, bool reference_probe) {
+            finished = true;
+            finished_tool = tool;
+            have_reference_probe = reference_probe;
+        }
+
+        void openatc_fail_tool_change(const char*) {
+            failed = true;
+            ++failure_count;
+        }
+    };
+
+    inline OpenATCJobTestResult openatc_run_job_channel_for_test(OpenATCConfigView const&                  cfg,
+                                                                 OpenATCChangePlan const&                  plan,
+                                                                 axis_t                                    magazine_axis,
+                                                                 tool_t                                    starting_tool,
+                                                                 tool_t                                    requested_tool,
+                                                                 bool                                      was_inch_mode,
+                                                                 std::vector<OpenATCSensorSnapshot> const& sensor_snapshots) {
+        OpenATCJobTestOwner owner { cfg, sensor_snapshots };
+        OpenATCJobSequencer<OpenATCJobTestOwner> sequencer(&owner, plan, magazine_axis, starting_tool, requested_tool, was_inch_mode);
+        OpenATCJobTestResult result;
+        char                 line[255];
+        size_t               line_number = 0;
+
+        for (size_t guard = 0; guard < 512 && !owner.failed; ++guard) {
+            Error poll_status = sequencer.pollLine(line, sizeof(line), line_number);
+            if (poll_status == Error::NoData) {
+                continue;
+            }
+            if (poll_status == Error::Eof) {
+                break;
+            }
+            if (poll_status != Error::Ok) {
+                owner.openatc_fail_tool_change("poll failed");
+                break;
+            }
+
+            result.emitted_lines.emplace_back(line);
+            sequencer.ack(Error::Ok);
+        }
+
+        result.finished             = owner.finished;
+        result.finished_tool        = owner.finished_tool;
+        result.have_reference_probe = owner.have_reference_probe;
+        result.failed               = owner.failed;
+        result.failure_count        = owner.failure_count;
+        return result;
+    }
+#endif
+}
diff --git a/FluidNC/src/ToolChangers/atc_openatc_model.h b/FluidNC/src/ToolChangers/atc_openatc_model.h
new file mode 100644
index 0000000..48414c2
--- /dev/null
+++ b/FluidNC/src/ToolChangers/atc_openatc_model.h
@@ -0,0 +1,501 @@
+// Copyright (c) 2026
+// Use of this source code is governed by a GPLv3 license that can be found in the LICENSE file.
+//
+// Pure OpenATC geometry and validation helpers for a linear bed-mounted magazine.
+
+#pragma once
+
+#include "Config.h"
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <string_view>
+#include <vector>
+
+namespace ATCs {
+    enum class OpenATCSpindleDirection : uint8_t {
+        CW,
+        CCW,
+    };
+
+    struct OpenATCActionConfig {
+        OpenATCSpindleDirection direction                 = OpenATCSpindleDirection::CW;
+        uint32_t                spindle_rpm               = 0;
+        uint32_t                spin_ms                   = 0;
+        uint32_t                passes                    = 1;
+        float                   retract_between_passes_mm = 0.0f;
+    };
+
+    struct OpenATCConfigView {
+        std::string_view           layout;
+        std::string_view           magazine_axis_name;
+        uint32_t                   pocket_count               = 0;
+        std::vector<float> const*  first_pocket_mpos_mm       = nullptr;
+        float                      pocket_pitch_mm            = 0.0f;
+        float                      safe_z_mpos_mm             = 0.0f;
+        float                      engage_z_mpos_mm           = 0.0f;
+        float                      travel_feed_mm_per_min     = 0.0f;
+        float                      engage_feed_mm_per_min     = 0.0f;
+        float                      retract_feed_mm_per_min    = 0.0f;
+        OpenATCActionConfig const* load                       = nullptr;
+        OpenATCActionConfig const* unload                     = nullptr;
+        std::vector<float> const*  toolsetter_mpos_mm         = nullptr;
+        float                      toolsetter_rapid_z_mpos_mm = 0.0f;
+        float                      probe_seek_rate_mm_per_min = 0.0f;
+        float                      probe_feed_rate_mm_per_min = 0.0f;
+        float                      probe_retract_mm           = 0.0f;
+    };
+
+    struct OpenATCXY {
+        float x = 0.0f;
+        float y = 0.0f;
+    };
+
+    struct OpenATCValidationResult {
+        bool        ok      = true;
+        const char* message = "";
+    };
+
+    struct OpenATCBounds {
+        float min[MAX_N_AXIS]   = {};
+        float max[MAX_N_AXIS]   = {};
+        bool  valid[MAX_N_AXIS] = {};
+    };
+
+    enum class OpenATCPlanStep : uint8_t {
+        UnloadCurrent,
+        LoadRequested,
+        ProbeReference,
+        ProbeRequestedAndApplyTlo,
+        ClearTlo,
+    };
+
+    struct OpenATCChangePlan {
+        std::array<OpenATCPlanStep, 5> steps {};
+        size_t                         count           = 0;
+        bool                           reference_after = false;
+    };
+
+    enum class OpenATCSensorDecision : uint8_t {
+        Pass,
+        RetryUnload,
+        Fail,
+    };
+
+    struct OpenATCSensorSnapshot {
+        bool tool_in_spindle_defined     = false;
+        bool tool_in_spindle             = false;
+        bool pocket_tool_present_defined = false;
+        bool pocket_tool_present         = false;
+        bool collet_clear_defined        = false;
+        bool collet_clear                = false;
+    };
+
+    inline bool openatc_equals_ci(std::string_view lhs, const char* rhs) {
+        if (rhs == nullptr || lhs.size() != std::strlen(rhs)) {
+            return false;
+        }
+
+        for (size_t i = 0; i < lhs.size(); ++i) {
+            char a = lhs[i];
+            char b = rhs[i];
+
+            if (a >= 'A' && a <= 'Z') {
+                a = char(a - 'A' + 'a');
+            }
+            if (b >= 'A' && b <= 'Z') {
+                b = char(b - 'A' + 'a');
+            }
+            if (a != b) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    inline bool openatc_parse_magazine_axis(std::string_view value, axis_t& axis) {
+        if (openatc_equals_ci(value, "x")) {
+            axis = X_AXIS;
+            return true;
+        }
+        if (openatc_equals_ci(value, "y")) {
+            axis = Y_AXIS;
+            return true;
+        }
+        return false;
+    }
+
+    inline bool openatc_parse_spindle_direction(std::string_view value, OpenATCSpindleDirection& direction) {
+        if (openatc_equals_ci(value, "cw")) {
+            direction = OpenATCSpindleDirection::CW;
+            return true;
+        }
+        if (openatc_equals_ci(value, "ccw")) {
+            direction = OpenATCSpindleDirection::CCW;
+            return true;
+        }
+        return false;
+    }
+
+    inline bool openatc_tool_is_pocket(tool_t tool, uint32_t pocket_count) {
+        return tool >= 1 && static_cast<uint32_t>(tool) <= pocket_count;
+    }
+
+    inline uint32_t openatc_pocket_index(tool_t tool) {
+        return static_cast<uint32_t>(tool) - 1;
+    }
+
+    inline OpenATCXY openatc_pocket_position(axis_t                    magazine_axis,
+                                             std::vector<float> const& first_pocket_mpos_mm,
+                                             float                     pocket_pitch_mm,
+                                             tool_t                    tool) {
+        OpenATCXY position { first_pocket_mpos_mm[0], first_pocket_mpos_mm[1] };
+        float     offset = pocket_pitch_mm * static_cast<float>(openatc_pocket_index(tool));
+
+        if (magazine_axis == X_AXIS) {
+            position.x += offset;
+        } else {
+            position.y += offset;
+        }
+
+        return position;
+    }
+
+    inline bool openatc_value_in_bounds(float value, float min_value, float max_value) {
+        return value >= min_value && value <= max_value;
+    }
+
+    inline bool openatc_xy_in_bounds(OpenATCXY position, OpenATCBounds const& bounds) {
+        return bounds.valid[X_AXIS] && bounds.valid[Y_AXIS] &&
+               openatc_value_in_bounds(position.x, bounds.min[X_AXIS], bounds.max[X_AXIS]) &&
+               openatc_value_in_bounds(position.y, bounds.min[Y_AXIS], bounds.max[Y_AXIS]);
+    }
+
+    inline bool openatc_z_in_bounds(float z, OpenATCBounds const& bounds) {
+        return bounds.valid[Z_AXIS] && openatc_value_in_bounds(z, bounds.min[Z_AXIS], bounds.max[Z_AXIS]);
+    }
+
+    inline void openatc_plan_add_step(OpenATCChangePlan& plan, OpenATCPlanStep step) {
+        plan.steps[plan.count++] = step;
+    }
+
+    inline OpenATCChangePlan openatc_build_change_plan(tool_t current_tool, tool_t requested_tool, bool have_reference_probe) {
+        OpenATCChangePlan plan;
+        plan.reference_after = have_reference_probe;
+
+        if (current_tool == requested_tool) {
+            return plan;
+        }
+
+        if (requested_tool == 0) {
+            if (current_tool != 0) {
+                openatc_plan_add_step(plan, OpenATCPlanStep::UnloadCurrent);
+            }
+            openatc_plan_add_step(plan, OpenATCPlanStep::ClearTlo);
+            plan.reference_after = false;
+            return plan;
+        }
+
+        if (current_tool != 0 && !plan.reference_after) {
+            openatc_plan_add_step(plan, OpenATCPlanStep::ProbeReference);
+            plan.reference_after = true;
+        }
+
+        if (current_tool != 0) {
+            openatc_plan_add_step(plan, OpenATCPlanStep::UnloadCurrent);
+        }
+
+        openatc_plan_add_step(plan, OpenATCPlanStep::LoadRequested);
+
+        if (plan.reference_after) {
+            openatc_plan_add_step(plan, OpenATCPlanStep::ProbeRequestedAndApplyTlo);
+        } else {
+            openatc_plan_add_step(plan, OpenATCPlanStep::ProbeReference);
+            plan.reference_after = true;
+        }
+
+        return plan;
+    }
+
+    inline bool openatc_plan_requires_macro(OpenATCChangePlan const& plan) {
+        return plan.count != 0;
+    }
+
+    template <typename Sink>
+    inline void openatc_add_stop_spindle(Sink& sink) {
+        sink.addf("M5");
+    }
+
+    template <typename Sink>
+    inline void openatc_add_move_safe_z(Sink& sink, OpenATCConfigView const& cfg) {
+        sink.addf("G53G0Z%0.3f", cfg.safe_z_mpos_mm);
+    }
+
+    template <typename Sink>
+    inline void openatc_add_move_xy(Sink& sink, OpenATCXY xy, OpenATCConfigView const& cfg) {
+        sink.addf("G53G1X%0.3fY%0.3fF%0.3f", xy.x, xy.y, cfg.travel_feed_mm_per_min);
+    }
+
+    template <typename Sink>
+    inline void openatc_add_move_engage_z(Sink& sink, OpenATCConfigView const& cfg) {
+        sink.addf("G53G1Z%0.3fF%0.3f", cfg.engage_z_mpos_mm, cfg.engage_feed_mm_per_min);
+    }
+
+    inline float openatc_retract_z_from_engage(OpenATCConfigView const& cfg, float retract_mm) {
+        float retract_z = cfg.engage_z_mpos_mm + retract_mm;
+        if (retract_z > cfg.safe_z_mpos_mm) {
+            retract_z = cfg.safe_z_mpos_mm;
+        }
+        return retract_z;
+    }
+
+    template <typename Sink>
+    inline void openatc_add_retract_from_engage(Sink& sink, OpenATCConfigView const& cfg, float retract_mm) {
+        if (retract_mm <= 0.0f) {
+            return;
+        }
+        sink.addf("G53G1Z%0.3fF%0.3f", openatc_retract_z_from_engage(cfg, retract_mm), cfg.retract_feed_mm_per_min);
+    }
+
+    template <typename Sink>
+    inline void openatc_add_action_pass(Sink& sink, OpenATCActionConfig const& action, OpenATCConfigView const& cfg) {
+        const char* mcode = action.direction == OpenATCSpindleDirection::CW ? "M3" : "M4";
+        sink.addf("%sS%u", mcode, action.spindle_rpm);
+        openatc_add_move_engage_z(sink, cfg);
+        sink.addf("G4P%0.3f", static_cast<float>(action.spin_ms) / 1000.0f);
+        sink.addf("M5");
+    }
+
+    template <typename Sink>
+    inline void openatc_add_action(Sink& sink, OpenATCActionConfig const& action, OpenATCConfigView const& cfg) {
+        for (uint32_t pass = 0; pass < action.passes; ++pass) {
+            openatc_add_action_pass(sink, action, cfg);
+
+            if ((pass + 1) < action.passes && action.retract_between_passes_mm > 0.0f) {
+                openatc_add_retract_from_engage(sink, cfg, action.retract_between_passes_mm);
+            }
+        }
+    }
+
+    template <typename Sink>
+    inline void openatc_add_failed_unload_retry(Sink& sink, OpenATCConfigView const& cfg) {
+        float retry_retract_mm = cfg.load == nullptr ? 0.0f : cfg.load->retract_between_passes_mm;
+        openatc_add_retract_from_engage(sink, cfg, retry_retract_mm);
+        openatc_add_action_pass(sink, *cfg.unload, cfg);
+        openatc_add_move_safe_z(sink, cfg);
+    }
+
+    template <typename Sink>
+    inline void openatc_add_unload(Sink& sink, OpenATCConfigView const& cfg, axis_t magazine_axis, tool_t tool) {
+        OpenATCXY pocket = openatc_pocket_position(magazine_axis, *cfg.first_pocket_mpos_mm, cfg.pocket_pitch_mm, tool);
+
+        openatc_add_stop_spindle(sink);
+        openatc_add_move_safe_z(sink, cfg);
+        openatc_add_move_xy(sink, pocket, cfg);
+        openatc_add_action_pass(sink, *cfg.unload, cfg);
+        openatc_add_move_safe_z(sink, cfg);
+    }
+
+    template <typename Sink>
+    inline void openatc_add_load(Sink& sink, OpenATCConfigView const& cfg, axis_t magazine_axis, tool_t tool) {
+        OpenATCXY pocket = openatc_pocket_position(magazine_axis, *cfg.first_pocket_mpos_mm, cfg.pocket_pitch_mm, tool);
+
+        openatc_add_stop_spindle(sink);
+        openatc_add_move_safe_z(sink, cfg);
+        openatc_add_move_xy(sink, pocket, cfg);
+        openatc_add_action(sink, *cfg.load, cfg);
+        openatc_add_move_safe_z(sink, cfg);
+    }
+
+    template <typename Sink>
+    inline void openatc_add_probe_cycle(Sink& sink, OpenATCConfigView const& cfg) {
+        openatc_add_move_safe_z(sink, cfg);
+        sink.addf("G53G1X%0.3fY%0.3fF%0.3f", (*cfg.toolsetter_mpos_mm)[0], (*cfg.toolsetter_mpos_mm)[1],
+                  cfg.travel_feed_mm_per_min);
+        sink.addf("G53G0Z%0.3f", cfg.toolsetter_rapid_z_mpos_mm);
+
+        if (cfg.probe_seek_rate_mm_per_min > cfg.probe_feed_rate_mm_per_min) {
+            sink.addf("G53G38.2Z%0.3fF%0.3f", (*cfg.toolsetter_mpos_mm)[2], cfg.probe_seek_rate_mm_per_min);
+            sink.addf("G53G0Z[#<_abs_z>+%0.3f]", cfg.probe_retract_mm);
+        }
+
+        sink.addf("G53G38.2Z%0.3fF%0.3f", (*cfg.toolsetter_mpos_mm)[2], cfg.probe_feed_rate_mm_per_min);
+    }
+
+    template <typename Sink>
+    inline void openatc_add_reference_probe(Sink& sink, OpenATCConfigView const& cfg) {
+        openatc_add_probe_cycle(sink, cfg);
+        sink.addf("#<_openatc_reference_z>=[#5063]");
+        sink.addf("G43.1Z0");
+        openatc_add_move_safe_z(sink, cfg);
+    }
+
+    template <typename Sink>
+    inline void openatc_add_tool_probe_and_tlo(Sink& sink, OpenATCConfigView const& cfg) {
+        openatc_add_probe_cycle(sink, cfg);
+        sink.addf("#<_openatc_tlo_z>=[#5063-#<_openatc_reference_z>]");
+        sink.addf("G43.1Z#<_openatc_tlo_z>");
+        openatc_add_move_safe_z(sink, cfg);
+    }
+
+    template <typename Sink>
+    inline void openatc_add_clear_tlo(Sink& sink) {
+        sink.addf("G49");
+        sink.addf("(MSG: OpenATC TLO cleared)");
+    }
+
+    template <typename Sink>
+    inline void openatc_emit_change_plan(Sink&                    sink,
+                                         OpenATCConfigView const& cfg,
+                                         axis_t                   magazine_axis,
+                                         OpenATCChangePlan const& plan,
+                                         tool_t                   current_tool,
+                                         tool_t                   requested_tool) {
+        for (size_t index = 0; index < plan.count; ++index) {
+            switch (plan.steps[index]) {
+                case OpenATCPlanStep::ProbeReference:
+                    openatc_add_reference_probe(sink, cfg);
+                    break;
+                case OpenATCPlanStep::UnloadCurrent:
+                    openatc_add_unload(sink, cfg, magazine_axis, current_tool);
+                    break;
+                case OpenATCPlanStep::LoadRequested:
+                    openatc_add_load(sink, cfg, magazine_axis, requested_tool);
+                    break;
+                case OpenATCPlanStep::ProbeRequestedAndApplyTlo:
+                    openatc_add_tool_probe_and_tlo(sink, cfg);
+                    break;
+                case OpenATCPlanStep::ClearTlo:
+                    openatc_add_clear_tlo(sink);
+                    break;
+            }
+        }
+    }
+
+    inline OpenATCValidationResult openatc_validate_action(OpenATCActionConfig const* action, const char* missing_message) {
+        if (action == nullptr) {
+            return { false, missing_message };
+        }
+        if (action->spindle_rpm == 0) {
+            return { false, "spindle_rpm must be greater than 0" };
+        }
+        if (action->spin_ms == 0) {
+            return { false, "spin_ms must be greater than 0" };
+        }
+        if (action->passes == 0) {
+            return { false, "passes must be greater than 0" };
+        }
+        if (action->retract_between_passes_mm < 0.0f) {
+            return { false, "retract_between_passes_mm must be non-negative" };
+        }
+
+        return {};
+    }
+
+    inline OpenATCValidationResult openatc_validate_config(OpenATCConfigView const& cfg) {
+        axis_t magazine_axis = INVALID_AXIS;
+
+        if (!openatc_equals_ci(cfg.layout, "linear")) {
+            return { false, "layout must be linear" };
+        }
+        if (!openatc_parse_magazine_axis(cfg.magazine_axis_name, magazine_axis)) {
+            return { false, "magazine_axis must be x or y" };
+        }
+        if (cfg.pocket_count == 0) {
+            return { false, "pocket_count must be greater than 0" };
+        }
+        if (cfg.pocket_count > static_cast<uint32_t>(std::numeric_limits<tool_t>::max())) {
+            return { false, "pocket_count exceeds FluidNC tool number range" };
+        }
+        if (cfg.first_pocket_mpos_mm == nullptr || cfg.first_pocket_mpos_mm->size() != 2) {
+            return { false, "first_pocket_mpos_mm must contain X and Y" };
+        }
+        if (cfg.pocket_pitch_mm <= 0.0f) {
+            return { false, "pocket_pitch_mm must be greater than 0" };
+        }
+        if (cfg.travel_feed_mm_per_min <= 0.0f || cfg.engage_feed_mm_per_min <= 0.0f || cfg.retract_feed_mm_per_min <= 0.0f) {
+            return { false, "feed rates must be greater than 0" };
+        }
+        if (cfg.toolsetter_mpos_mm == nullptr || cfg.toolsetter_mpos_mm->size() != 3) {
+            return { false, "toolsetter_mpos_mm must contain X, Y, and Z" };
+        }
+        if (cfg.probe_seek_rate_mm_per_min <= 0.0f || cfg.probe_feed_rate_mm_per_min <= 0.0f) {
+            return { false, "probe feed rates must be greater than 0" };
+        }
+        if (cfg.probe_retract_mm <= 0.0f) {
+            return { false, "probe_retract_mm must be greater than 0" };
+        }
+
+        OpenATCValidationResult load = openatc_validate_action(cfg.load, "load section is required");
+        if (!load.ok) {
+            return load;
+        }
+
+        OpenATCValidationResult unload = openatc_validate_action(cfg.unload, "unload section is required");
+        if (!unload.ok) {
+            return unload;
+        }
+
+        return {};
+    }
+
+    inline OpenATCValidationResult openatc_validate_bounds(OpenATCConfigView const& cfg, OpenATCBounds const& bounds) {
+        axis_t magazine_axis = INVALID_AXIS;
+        if (!openatc_parse_magazine_axis(cfg.magazine_axis_name, magazine_axis)) {
+            return { false, "magazine_axis must be x or y" };
+        }
+        if (!openatc_z_in_bounds(cfg.safe_z_mpos_mm, bounds) || !openatc_z_in_bounds(cfg.engage_z_mpos_mm, bounds) ||
+            !openatc_z_in_bounds(cfg.toolsetter_rapid_z_mpos_mm, bounds) || !openatc_z_in_bounds((*cfg.toolsetter_mpos_mm)[2], bounds)) {
+            return { false, "Z target is outside machine bounds" };
+        }
+
+        OpenATCXY toolsetter { (*cfg.toolsetter_mpos_mm)[0], (*cfg.toolsetter_mpos_mm)[1] };
+        if (!openatc_xy_in_bounds(toolsetter, bounds)) {
+            return { false, "toolsetter XY is outside machine bounds" };
+        }
+
+        for (uint32_t tool_number = 1; tool_number <= cfg.pocket_count; ++tool_number) {
+            OpenATCXY pocket = openatc_pocket_position(
+                magazine_axis, *cfg.first_pocket_mpos_mm, cfg.pocket_pitch_mm, static_cast<tool_t>(tool_number));
+            if (!openatc_xy_in_bounds(pocket, bounds)) {
+                return { false, "pocket target is outside machine bounds" };
+            }
+        }
+
+        return {};
+    }
+
+    inline OpenATCSensorDecision openatc_decide_after_unload(OpenATCSensorSnapshot const& sensors, bool retry_available) {
+        bool ok = true;
+        if (sensors.tool_in_spindle_defined) {
+            ok = ok && !sensors.tool_in_spindle;
+        }
+        if (sensors.pocket_tool_present_defined) {
+            ok = ok && sensors.pocket_tool_present;
+        }
+        if (sensors.collet_clear_defined) {
+            ok = ok && sensors.collet_clear;
+        }
+        if (ok) {
+            return OpenATCSensorDecision::Pass;
+        }
+        return retry_available ? OpenATCSensorDecision::RetryUnload : OpenATCSensorDecision::Fail;
+    }
+
+    inline bool openatc_decide_after_load(OpenATCSensorSnapshot const& sensors) {
+        bool ok = true;
+        if (sensors.tool_in_spindle_defined) {
+            ok = ok && sensors.tool_in_spindle;
+        }
+        if (sensors.pocket_tool_present_defined) {
+            ok = ok && !sensors.pocket_tool_present;
+        }
+        if (sensors.collet_clear_defined) {
+            ok = ok && sensors.collet_clear;
+        }
+        return ok;
+    }
