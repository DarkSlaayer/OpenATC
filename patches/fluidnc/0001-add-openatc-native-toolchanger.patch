diff --git a/FluidNC/src/ToolChangers/atc_openatc.cpp b/FluidNC/src/ToolChangers/atc_openatc.cpp
new file mode 100644
index 0000000..e119fc1
--- /dev/null
+++ b/FluidNC/src/ToolChangers/atc_openatc.cpp
@@ -0,0 +1,390 @@
+// Copyright (c) 2026
+// Use of this source code is governed by a GPLv3 license that can be found in the LICENSE file.
+
+#include "atc_openatc.h"
+#include "atc_openatc_job.h"
+
+#include "GCode.h"
+#include "Job.h"
+#include "Limit.h"
+#include "Logging.h"
+#include "Machine/Axes.h"
+#include "Machine/Homing.h"
+#include "Protocol.h"
+#include "Report.h"
+#include "Spindles/Spindle.h"
+
+#include <limits>
+
+namespace ATCs {
+    class OpenATCJobChannel : public Channel {
+    public:
+        OpenATCJobChannel(OpenATC* owner,
+                          OpenATCChangePlan const& plan,
+                          axis_t magazine_axis,
+                          tool_t starting_tool,
+                          tool_t requested_tool,
+                          bool was_inch_mode)
+            : Channel("OpenATC", false),
+              _owner(owner),
+              _sequencer(this, plan, magazine_axis, starting_tool, requested_tool, was_inch_mode) {}
+
+        Error pollLine(char* line) override { return _sequencer.pollLine(line, Channel::maxLine, _line_number); }
+        void  ack(Error status) override { _sequencer.ack(status); }
+        size_t write(uint8_t c) override { return 0; }
+
+        OpenATCConfigView openatc_config_view() const { return _owner->config_view(); }
+        OpenATCSensorSnapshot openatc_sensor_snapshot() const { return _owner->sensor_snapshot(); }
+        void openatc_finish_tool_change(tool_t tool, bool have_reference_probe) { _owner->finish_tool_change(tool, have_reference_probe); }
+        void openatc_fail_tool_change(const char* message) { _owner->fail_tool_change(message); }
+
+    private:
+        OpenATC* _owner = nullptr;
+        OpenATCJobSequencer<OpenATCJobChannel> _sequencer;
+    };
+
+    void OpenATCActionSection::group(Configuration::HandlerBase& handler) {
+        handler.item("spindle_direction", direction_name, 1, 8);
+        handler.item("spindle_rpm", spindle_rpm, 1, 100000);
+        handler.item("spin_ms", spin_ms, 1, 60000);
+    }
+
+    void OpenATCActionSection::afterParse() {
+        OpenATCSpindleDirection parsed = OpenATCSpindleDirection::CW;
+        if (openatc_parse_spindle_direction(direction_name, parsed)) {
+            parsed_direction = parsed;
+        }
+    }
+
+    void OpenATCActionSection::validate() {
+        OpenATCSpindleDirection parsed = OpenATCSpindleDirection::CW;
+        Assert(openatc_parse_spindle_direction(direction_name, parsed), "OpenATC spindle_direction must be cw or ccw");
+
+        OpenATCActionConfig     cfg    = view();
+        OpenATCValidationResult result = openatc_validate_action(&cfg, "action section is required");
+        Assert(result.ok, "OpenATC action config invalid: %s", result.message);
+    }
+
+    OpenATCActionConfig OpenATCActionSection::view() const {
+        OpenATCActionConfig cfg;
+        cfg.direction                 = parsed_direction;
+        cfg.spindle_rpm               = spindle_rpm;
+        cfg.spin_ms                   = spin_ms;
+        cfg.passes                    = 1;
+        cfg.retract_between_passes_mm = 0.0f;
+        return cfg;
+    }
+
+    void OpenATCLoadActionSection::group(Configuration::HandlerBase& handler) {
+        OpenATCActionSection::group(handler);
+        handler.item("passes", passes, 1, 20);
+        handler.item("retract_between_passes_mm", retract_between_passes_mm, 0.0f, 1000.0f);
+    }
+
+    OpenATCActionConfig OpenATCLoadActionSection::view() const {
+        OpenATCActionConfig cfg = OpenATCActionSection::view();
+        cfg.passes                    = passes;
+        cfg.retract_between_passes_mm = retract_between_passes_mm;
+        return cfg;
+    }
+
+    OpenATC::~OpenATC() {
+        delete _load;
+        delete _unload;
+    }
+
+    void OpenATC::group(Configuration::HandlerBase& handler) {
+        handler.item("layout", _layout, 1, 16);
+        handler.item("magazine_axis", _magazine_axis, 1, 8);
+        handler.item("pocket_count", _pocket_count, 1, 100);
+        handler.item("first_pocket_mpos_mm", _first_pocket_mpos_mm);
+        handler.item("pocket_pitch_mm", _pocket_pitch_mm, 0.001f, 100000.0f);
+
+        handler.item("safe_z_mpos_mm", _safe_z_mpos_mm);
+        handler.item("engage_z_mpos_mm", _engage_z_mpos_mm);
+        handler.item("travel_feed_mm_per_min", _travel_feed_mm_per_min, 1.0f, 100000.0f);
+        handler.item("engage_feed_mm_per_min", _engage_feed_mm_per_min, 1.0f, 100000.0f);
+        handler.item("retract_feed_mm_per_min", _retract_feed_mm_per_min, 1.0f, 100000.0f);
+
+        handler.section("load", _load);
+        handler.section("unload", _unload);
+
+        handler.item("toolsetter_mpos_mm", _toolsetter_mpos_mm);
+        handler.item("toolsetter_rapid_z_mpos_mm", _toolsetter_rapid_z_mpos_mm);
+        handler.item("probe_seek_rate_mm_per_min", _probe_seek_rate_mm_per_min, 1.0f, 100000.0f);
+        handler.item("probe_feed_rate_mm_per_min", _probe_feed_rate_mm_per_min, 1.0f, 100000.0f);
+        handler.item("probe_retract_mm", _probe_retract_mm, 0.001f, 1000.0f);
+
+        handler.item("tool_in_spindle_pin", _tool_in_spindle_pin);
+        handler.item("pocket_tool_present_pin", _pocket_tool_present_pin);
+        handler.item("collet_clear_pin", _collet_clear_pin);
+    }
+
+    void OpenATC::afterParse() {
+        Assert(openatc_parse_magazine_axis(_magazine_axis, _parsed_magazine_axis), "OpenATC magazine_axis must be x or y");
+    }
+
+    void OpenATC::refresh_action_views() {
+        if (_load != nullptr) {
+            _load_view = _load->view();
+        }
+        if (_unload != nullptr) {
+            _unload_view = _unload->view();
+        }
+    }
+
+    OpenATCConfigView OpenATC::config_view() const {
+        return { _layout,
+                 _magazine_axis,
+                 _pocket_count,
+                 &_first_pocket_mpos_mm,
+                 _pocket_pitch_mm,
+                 _safe_z_mpos_mm,
+                 _engage_z_mpos_mm,
+                 _travel_feed_mm_per_min,
+                 _engage_feed_mm_per_min,
+                 _retract_feed_mm_per_min,
+                 _load == nullptr ? nullptr : &_load_view,
+                 _unload == nullptr ? nullptr : &_unload_view,
+                 &_toolsetter_mpos_mm,
+                 _toolsetter_rapid_z_mpos_mm,
+                 _probe_seek_rate_mm_per_min,
+                 _probe_feed_rate_mm_per_min,
+                 _probe_retract_mm };
+    }
+
+    void OpenATC::validate() {
+        refresh_action_views();
+        OpenATCValidationResult result = openatc_validate_config(config_view());
+        Assert(result.ok, "OpenATC config invalid: %s", result.message);
+    }
+
+    OpenATCBounds OpenATC::machine_bounds() const {
+        OpenATCBounds bounds;
+
+        for (axis_t axis = X_AXIS; axis <= Z_AXIS; ++axis) {
+            bounds.valid[axis] = Machine::Axes::_axis[axis] != nullptr;
+            if (bounds.valid[axis]) {
+                bounds.min[axis] = limitsMinPosition(axis);
+                bounds.max[axis] = limitsMaxPosition(axis);
+            }
+        }
+
+        return bounds;
+    }
+
+    bool OpenATC::required_axes_homed() const {
+        return Machine::Homing::axis_is_homed(X_AXIS) && Machine::Homing::axis_is_homed(Y_AXIS) &&
+               Machine::Homing::axis_is_homed(Z_AXIS);
+    }
+
+    bool OpenATC::fail_validation(const char* message) {
+        log_error("OpenATC " << message);
+        send_alarm(ExecAlarm::SpindleControl);
+        return false;
+    }
+
+    bool OpenATC::validate_spindle_direction(OpenATCActionSection const& action) {
+        if (action.parsed_direction != OpenATCSpindleDirection::CCW) {
+            return true;
+        }
+
+        if (spindle != nullptr && spindle->is_reversable) {
+            return true;
+        }
+
+        return fail_validation("ccw action requires a reversible spindle");
+    }
+
+    bool OpenATC::validate_runtime(tool_t requested_tool, bool allow_zero) {
+        refresh_action_views();
+
+        OpenATCValidationResult config_result = openatc_validate_config(config_view());
+        if (!config_result.ok) {
+            log_error("OpenATC config invalid: " << config_result.message);
+            send_alarm(ExecAlarm::SpindleControl);
+            return false;
+        }
+
+        if (!allow_zero && requested_tool == 0) {
+            return fail_validation("requested tool 0 is not valid for this operation");
+        }
+        if (requested_tool != 0 && !openatc_tool_is_pocket(requested_tool, _pocket_count)) {
+            return fail_validation("requested tool is outside configured pocket range");
+        }
+        if (gc_state.current_tool < 0) {
+            return fail_validation("current tool is unknown; declare state with M61 first");
+        }
+        if (gc_state.current_tool > static_cast<int32_t>(std::numeric_limits<tool_t>::max())) {
+            return fail_validation("current tool exceeds FluidNC tool number range");
+        }
+        if (gc_state.current_tool != 0 && !openatc_tool_is_pocket(static_cast<tool_t>(gc_state.current_tool), _pocket_count)) {
+            return fail_validation("current tool is outside configured pocket range");
+        }
+        if (gc_state.modal.plane_select != Plane::XY) {
+            return fail_validation("requires G17 XY plane");
+        }
+        if (!required_axes_homed()) {
+            return fail_validation("requires X/Y/Z homed before tool change");
+        }
+
+        OpenATCValidationResult bounds_result = openatc_validate_bounds(config_view(), machine_bounds());
+        if (!bounds_result.ok) {
+            log_error("OpenATC bounds invalid: " << bounds_result.message);
+            send_alarm(ExecAlarm::SpindleControl);
+            return false;
+        }
+
+        if (_load == nullptr || _unload == nullptr) {
+            return fail_validation("load and unload sections are required");
+        }
+        if (!validate_spindle_direction(*_load) || !validate_spindle_direction(*_unload)) {
+            return false;
+        }
+
+        return true;
+    }
+
+    bool OpenATC::check_sensor(InputPin& pin, bool expected, const char* label) {
+        if (pin.undefined()) {
+            return true;
+        }
+
+        bool actual = pin.read();
+        if (actual == expected) {
+            return true;
+        }
+
+        log_error("OpenATC sensor mismatch: " << label);
+        send_alarm(ExecAlarm::SpindleControl);
+        return false;
+    }
+
+    bool OpenATC::check_initial_sensors(tool_t requested_tool) {
+        if (gc_state.current_tool == 0 && requested_tool != 0) {
+            return check_sensor(_tool_in_spindle_pin, false, "tool_in_spindle before load") &&
+                   check_sensor(_collet_clear_pin, true, "collet_clear before load");
+        }
+
+        if (gc_state.current_tool != 0) {
+            return check_sensor(_tool_in_spindle_pin, true, "tool_in_spindle before unload");
+        }
+
+        return true;
+    }
+
+    void OpenATC::init() {
+        log_info("ATC:" << name());
+        configure_sensor(_tool_in_spindle_pin);
+        configure_sensor(_pocket_tool_present_pin);
+        configure_sensor(_collet_clear_pin);
+    }
+
+    void OpenATC::probe_notification() {}
+
+    bool OpenATC::tool_change(tool_t value, bool pre_select, bool set_tool) {
+        if (pre_select) {
+            return true;
+        }
+
+        protocol_buffer_synchronize();
+
+        if (set_tool) {
+            if (value != 0 && !openatc_tool_is_pocket(value, _pocket_count)) {
+                return fail_validation("M61 tool is outside configured pocket range");
+            }
+            _have_reference_probe = false;
+            return true;
+        }
+
+        if (value == 0) {
+            if (gc_state.current_tool < 0) {
+                return fail_validation("current tool is unknown; declare state with M61 first");
+            }
+
+            if (gc_state.current_tool != 0 && !validate_runtime(value, true)) {
+                return false;
+            }
+            if (!check_initial_sensors(value)) {
+                return false;
+            }
+
+            OpenATCChangePlan plan = openatc_build_change_plan(static_cast<tool_t>(gc_state.current_tool), value, _have_reference_probe);
+            if (!openatc_plan_requires_macro(plan)) {
+                return true;
+            }
+
+            bool was_inch_mode = gc_state.modal.units == Units::Inches;
+            Job::save();
+            Job::nest(new OpenATCJobChannel(this,
+                                            plan,
+                                            _parsed_magazine_axis,
+                                            static_cast<tool_t>(gc_state.current_tool),
+                                            value,
+                                            was_inch_mode),
+                      nullptr);
+            return true;
+        }
+
+        if (gc_state.current_tool == static_cast<int32_t>(value)) {
+            return true;
+        }
+
+        if (!validate_runtime(value, false)) {
+            return false;
+        }
+        if (!check_initial_sensors(value)) {
+            return false;
+        }
+
+        OpenATCChangePlan plan = openatc_build_change_plan(static_cast<tool_t>(gc_state.current_tool), value, _have_reference_probe);
+        bool was_inch_mode = gc_state.modal.units == Units::Inches;
+        Job::save();
+        Job::nest(new OpenATCJobChannel(this,
+                                        plan,
+                                        _parsed_magazine_axis,
+                                        static_cast<tool_t>(gc_state.current_tool),
+                                        value,
+                                        was_inch_mode),
+                  nullptr);
+        return true;
+    }
+
+    void OpenATC::configure_sensor(InputPin& pin) {
+        if (!pin.undefined()) {
+            pin.init();
+        }
+    }
+
+    void OpenATC::finish_tool_change(tool_t tool, bool have_reference_probe) {
+        _have_reference_probe = have_reference_probe;
+        set_current_tool(tool);
+        report_ovr_counter = 0;
+        gc_ovr_changed();
+    }
+
+    void OpenATC::fail_tool_change(const char* message) {
+        log_error("OpenATC " << message);
+        send_alarm(ExecAlarm::SpindleControl);
+    }
+
+    OpenATCSensorSnapshot OpenATC::sensor_snapshot() const {
+        OpenATCSensorSnapshot snapshot;
+        snapshot.tool_in_spindle_defined = !_tool_in_spindle_pin.undefined();
+        snapshot.tool_in_spindle = snapshot.tool_in_spindle_defined && _tool_in_spindle_pin.read();
+        snapshot.pocket_tool_present_defined = !_pocket_tool_present_pin.undefined();
+        snapshot.pocket_tool_present = snapshot.pocket_tool_present_defined && _pocket_tool_present_pin.read();
+        snapshot.collet_clear_defined = !_collet_clear_pin.undefined();
+        snapshot.collet_clear = snapshot.collet_clear_defined && _collet_clear_pin.read();
+        return snapshot;
+    }
+
+    void OpenATC::set_current_tool(tool_t tool) {
+        gc_state.current_tool  = tool;
+        gc_state.selected_tool = tool;
+    }
+
+    namespace {
+        ATCFactory::InstanceBuilder<OpenATC> registration("openatc");
+    }
+}
