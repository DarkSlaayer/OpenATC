+#include "gtest/gtest.h"
+
+#include "ToolChangers/atc_openatc_job.h"
+#include "ToolChangers/atc_openatc_model.h"
+
+#include <cstdarg>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+using namespace ATCs;
+
+namespace {
+struct RecordingMacro {
+    std::vector<std::string> lines;
+
+    void addf(const char* format, ...) {
+        char    buffer[160];
+        va_list args;
+        va_start(args, format);
+        std::vsnprintf(buffer, sizeof(buffer), format, args);
+        va_end(args);
+        lines.emplace_back(buffer);
+    }
+};
+
+OpenATCActionConfig action() {
+    OpenATCActionConfig cfg;
+    cfg.spindle_rpm = 1600;
+    cfg.spin_ms     = 1000;
+    cfg.passes      = 1;
+    return cfg;
+}
+
+OpenATCConfigView valid_config(std::vector<float>&      first_pocket,
+                               std::vector<float>&      toolsetter,
+                               OpenATCActionConfig& load,
+                               OpenATCActionConfig& unload) {
+    return {
+        "linear",
+        "x",
+        4,
+        &first_pocket,
+        38.0f,
+        -20.0f,
+        -124.5f,
+        4000.0f,
+        1200.0f,
+        1000.0f,
+        &load,
+        &unload,
+        &toolsetter,
+        -40.0f,
+        500.0f,
+        25.0f,
+        3.0f,
+    };
+}
+
+OpenATCBounds bounds() {
+    OpenATCBounds b;
+    b.valid[X_AXIS] = true;
+    b.valid[Y_AXIS] = true;
+    b.valid[Z_AXIS] = true;
+    b.min[X_AXIS]   = -400.0f;
+    b.max[X_AXIS]   = 10.0f;
+    b.min[Y_AXIS]   = -900.0f;
+    b.max[Y_AXIS]   = 10.0f;
+    b.min[Z_AXIS]   = -150.0f;
+    b.max[Z_AXIS]   = 0.0f;
+    return b;
+}
+
+std::vector<std::string> emit_change_lines(OpenATCConfigView const& cfg,
+                                           tool_t                   current_tool,
+                                           tool_t                   requested_tool,
+                                           bool                     have_reference_probe) {
+    RecordingMacro    macro;
+    OpenATCChangePlan plan = openatc_build_change_plan(current_tool, requested_tool, have_reference_probe);
+    openatc_emit_change_plan(macro, cfg, X_AXIS, plan, current_tool, requested_tool);
+    return macro.lines;
+}
+
+size_t find_line(std::vector<std::string> const& lines, std::string const& needle, size_t start = 0) {
+    for (size_t index = start; index < lines.size(); ++index) {
+        if (lines[index] == needle) {
+            return index;
+        }
+    }
+    return lines.size();
+}
+}  // namespace
+
+TEST(OpenATCModel, ParsesOnlyXAndYMagazineAxes) {
+    axis_t axis = INVALID_AXIS;
+    EXPECT_TRUE(openatc_parse_magazine_axis("x", axis));
+    EXPECT_EQ(axis, X_AXIS);
+    EXPECT_TRUE(openatc_parse_magazine_axis("Y", axis));
+    EXPECT_EQ(axis, Y_AXIS);
+    EXPECT_FALSE(openatc_parse_magazine_axis("z", axis));
+    EXPECT_FALSE(openatc_parse_magazine_axis("theta", axis));
+}
+
+TEST(OpenATCModel, ParsesOnlyKnownSpindleDirections) {
+    OpenATCSpindleDirection direction = OpenATCSpindleDirection::CW;
+    EXPECT_TRUE(openatc_parse_spindle_direction("cw", direction));
+    EXPECT_EQ(direction, OpenATCSpindleDirection::CW);
+    EXPECT_TRUE(openatc_parse_spindle_direction("CCW", direction));
+    EXPECT_EQ(direction, OpenATCSpindleDirection::CCW);
+    EXPECT_FALSE(openatc_parse_spindle_direction("reverse", direction));
+}
+
+TEST(OpenATCModel, MapsToolNumbersToPocketIndexes) {
+    EXPECT_TRUE(openatc_tool_is_pocket(1, 8));
+    EXPECT_TRUE(openatc_tool_is_pocket(8, 8));
+    EXPECT_FALSE(openatc_tool_is_pocket(0, 8));
+    EXPECT_FALSE(openatc_tool_is_pocket(9, 8));
+    EXPECT_EQ(openatc_pocket_index(1), 0u);
+    EXPECT_EQ(openatc_pocket_index(4), 3u);
+}
+
+TEST(OpenATCModel, ComputesXPocketPositions) {
+    std::vector<float> first { -280.0f, -728.0f };
+    OpenATCXY          pocket1 = openatc_pocket_position(X_AXIS, first, 38.0f, 1);
+    OpenATCXY          pocket3 = openatc_pocket_position(X_AXIS, first, 38.0f, 3);
+    EXPECT_FLOAT_EQ(pocket1.x, -280.0f);
+    EXPECT_FLOAT_EQ(pocket1.y, -728.0f);
+    EXPECT_FLOAT_EQ(pocket3.x, -204.0f);
+    EXPECT_FLOAT_EQ(pocket3.y, -728.0f);
+}
+
+TEST(OpenATCModel, ComputesYPocketPositions) {
+    std::vector<float> first { -280.0f, -728.0f };
+    OpenATCXY          pocket1 = openatc_pocket_position(Y_AXIS, first, 38.0f, 1);
+    OpenATCXY          pocket3 = openatc_pocket_position(Y_AXIS, first, 38.0f, 3);
+    EXPECT_FLOAT_EQ(pocket1.x, -280.0f);
+    EXPECT_FLOAT_EQ(pocket1.y, -728.0f);
+    EXPECT_FLOAT_EQ(pocket3.x, -280.0f);
+    EXPECT_FLOAT_EQ(pocket3.y, -652.0f);
+}
+
+TEST(OpenATCModel, ValidatesConfigShape) {
+    std::vector<float>   first { -280.0f, -728.0f };
+    std::vector<float>   toolsetter { -24.0f, -784.0f, -130.0f };
+    OpenATCActionConfig  load   = action();
+    OpenATCActionConfig  unload = action();
+    OpenATCConfigView    cfg    = valid_config(first, toolsetter, load, unload);
+
+    EXPECT_TRUE(openatc_validate_config(cfg).ok);
+
+    cfg.layout = "grid";
+    EXPECT_FALSE(openatc_validate_config(cfg).ok);
+    cfg.layout = "linear";
+
+    cfg.magazine_axis_name = "z";
+    EXPECT_FALSE(openatc_validate_config(cfg).ok);
+    cfg.magazine_axis_name = "x";
+
+    cfg.pocket_count = 0;
+    EXPECT_FALSE(openatc_validate_config(cfg).ok);
+    cfg.pocket_count = 4;
+
+    cfg.first_pocket_mpos_mm = nullptr;
+    EXPECT_FALSE(openatc_validate_config(cfg).ok);
+}
+
+TEST(OpenATCModel, ValidatesActionShape) {
+    OpenATCActionConfig cfg = action();
+    EXPECT_TRUE(openatc_validate_action(&cfg, "missing").ok);
+
+    cfg.spindle_rpm = 0;
+    EXPECT_FALSE(openatc_validate_action(&cfg, "missing").ok);
+    cfg = action();
+
+    cfg.spin_ms = 0;
+    EXPECT_FALSE(openatc_validate_action(&cfg, "missing").ok);
+    cfg = action();
+
+    cfg.passes = 0;
+    EXPECT_FALSE(openatc_validate_action(&cfg, "missing").ok);
+    cfg = action();
+
+    cfg.retract_between_passes_mm = -1.0f;
+    EXPECT_FALSE(openatc_validate_action(&cfg, "missing").ok);
+}
+
+TEST(OpenATCModel, ValidatesBounds) {
+    std::vector<float>   first { -280.0f, -728.0f };
+    std::vector<float>   toolsetter { -24.0f, -784.0f, -130.0f };
+    OpenATCActionConfig  load   = action();
+    OpenATCActionConfig  unload = action();
+    OpenATCConfigView    cfg    = valid_config(first, toolsetter, load, unload);
+
+    EXPECT_TRUE(openatc_validate_bounds(cfg, bounds()).ok);
+
+    OpenATCBounds tight = bounds();
+    tight.max[X_AXIS]   = -260.0f;
+    EXPECT_FALSE(openatc_validate_bounds(cfg, tight).ok);
+
+    tight             = bounds();
+    tight.min[Z_AXIS] = -120.0f;
+    EXPECT_FALSE(openatc_validate_bounds(cfg, tight).ok);
+}
