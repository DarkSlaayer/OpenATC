+TEST(OpenATCSensorModel, UnloadPassesWhenToolBeamIsClear) {
+    OpenATCSensorSnapshot sensors;
+    sensors.tool_in_spindle_defined = true;
+    sensors.tool_in_spindle         = false;
+
+    EXPECT_EQ(openatc_decide_after_unload(sensors, true), OpenATCSensorDecision::Pass);
+}
+
+TEST(OpenATCSensorModel, FailedUnloadRetriesOnceThenFails) {
+    OpenATCSensorSnapshot sensors;
+    sensors.tool_in_spindle_defined = true;
+    sensors.tool_in_spindle         = true;
+
+    EXPECT_EQ(openatc_decide_after_unload(sensors, true), OpenATCSensorDecision::RetryUnload);
+    EXPECT_EQ(openatc_decide_after_unload(sensors, false), OpenATCSensorDecision::Fail);
+}
+
+TEST(OpenATCSensorModel, LoadPassesWhenToolBeamIsBlocked) {
+    OpenATCSensorSnapshot sensors;
+    sensors.tool_in_spindle_defined = true;
+    sensors.tool_in_spindle         = true;
+
+    EXPECT_TRUE(openatc_decide_after_load(sensors));
+}
+
+TEST(OpenATCSensorModel, LoadFailsWhenToolSensorDoesNotSeeLoadedTool) {
+    OpenATCSensorSnapshot sensors;
+    sensors.tool_in_spindle_defined = true;
+    sensors.tool_in_spindle         = false;
+
+    EXPECT_FALSE(openatc_decide_after_load(sensors));
+}
