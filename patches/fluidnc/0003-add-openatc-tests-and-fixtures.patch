+TEST(OpenATCModel, PlansFirstLoadAsReferenceTool) {
+    OpenATCChangePlan plan = openatc_build_change_plan(0, 2, false);
+
+    ASSERT_EQ(plan.count, 2u);
+    EXPECT_EQ(plan.steps[0], OpenATCPlanStep::LoadRequested);
+    EXPECT_EQ(plan.steps[1], OpenATCPlanStep::ProbeReference);
+    EXPECT_TRUE(plan.reference_after);
+}
+
+TEST(OpenATCModel, PlansSwapWithExistingReferenceAsUnloadLoadAndTloProbe) {
+    OpenATCChangePlan plan = openatc_build_change_plan(1, 3, true);
+
+    ASSERT_EQ(plan.count, 3u);
+    EXPECT_EQ(plan.steps[0], OpenATCPlanStep::UnloadCurrent);
+    EXPECT_EQ(plan.steps[1], OpenATCPlanStep::LoadRequested);
+    EXPECT_EQ(plan.steps[2], OpenATCPlanStep::ProbeRequestedAndApplyTlo);
+    EXPECT_TRUE(plan.reference_after);
+}
+
+TEST(OpenATCModel, PlansDeclaredCurrentToolWithoutReferenceByProbingBeforeUnload) {
+    OpenATCChangePlan plan = openatc_build_change_plan(1, 3, false);
+
+    ASSERT_EQ(plan.count, 4u);
+    EXPECT_EQ(plan.steps[0], OpenATCPlanStep::ProbeReference);
+    EXPECT_EQ(plan.steps[1], OpenATCPlanStep::UnloadCurrent);
+    EXPECT_EQ(plan.steps[2], OpenATCPlanStep::LoadRequested);
+    EXPECT_EQ(plan.steps[3], OpenATCPlanStep::ProbeRequestedAndApplyTlo);
+    EXPECT_TRUE(plan.reference_after);
+}
+
+TEST(OpenATCModel, PlansUnloadAsUnloadAndClearTlo) {
+    OpenATCChangePlan plan = openatc_build_change_plan(4, 0, true);
+
+    ASSERT_EQ(plan.count, 2u);
+    EXPECT_EQ(plan.steps[0], OpenATCPlanStep::UnloadCurrent);
+    EXPECT_EQ(plan.steps[1], OpenATCPlanStep::ClearTlo);
+    EXPECT_FALSE(plan.reference_after);
+}
+
+TEST(OpenATCModel, PlansSameToolAsNoOp) {
+    OpenATCChangePlan plan = openatc_build_change_plan(3, 3, true);
+
+    EXPECT_EQ(plan.count, 0u);
+    EXPECT_TRUE(plan.reference_after);
+}
+
+TEST(OpenATCModel, SameToolPlanDoesNotRequireMacro) {
+    OpenATCChangePlan plan = openatc_build_change_plan(0, 0, false);
+
+    EXPECT_FALSE(openatc_plan_requires_macro(plan));
+}
+
+TEST(OpenATCModel, EmitsFirstLoadReferenceGCode) {
+    std::vector<float>  first { -280.0f, -728.0f };
+    std::vector<float>  toolsetter { -24.0f, -784.0f, -130.0f };
