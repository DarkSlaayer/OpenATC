+
+    std::vector<std::string> lines = emit_change_lines(cfg, 0, 2, false);
+
+    EXPECT_EQ(lines, (std::vector<std::string> {
+                         "M5",
+                         "G53G0Z-20.000",
+                         "G53G1X-242.000Y-728.000F4000.000",
+                         "M3S1600",
+                         "G53G1Z-124.500F1200.000",
+                         "G4P1.000",
+                         "M5",
+                         "G53G1Z-74.500F1000.000",
+                         "M3S1600",
+                         "G53G1Z-124.500F1200.000",
+                         "G4P1.000",
+                         "M5",
+                         "G53G0Z-20.000",
+                         "G53G0Z-20.000",
+                         "G53G1X-24.000Y-784.000F4000.000",
+                         "G53G0Z-40.000",
+                         "G53G38.2Z-130.000F500.000",
+                         "G53G0Z[#<_abs_z>+3.000]",
+                         "G53G38.2Z-130.000F25.000",
+                         "#<_openatc_reference_z>=[#5063]",
+                         "G43.1Z0",
+                         "G53G0Z-20.000",
+                     }));
+}
+
+TEST(OpenATCModel, EmitsDeclaredToolSwapReferenceBeforeUnload) {
+    std::vector<float>  first { -280.0f, -728.0f };
+    std::vector<float>  toolsetter { -24.0f, -784.0f, -130.0f };
+    OpenATCActionConfig load   = action();
+    OpenATCActionConfig unload = action();
+    unload.direction           = OpenATCSpindleDirection::CCW;
+    unload.spindle_rpm         = 1800;
+    OpenATCConfigView cfg      = valid_config(first, toolsetter, load, unload);
+
+    std::vector<std::string> lines = emit_change_lines(cfg, 1, 3, false);
+
+    size_t reference_capture = find_line(lines, "#<_openatc_reference_z>=[#5063]");
+    size_t first_unload      = find_line(lines, "M4S1800");
+    size_t unload_pocket     = find_line(lines, "G53G1X-280.000Y-728.000F4000.000");
+    size_t load_pocket       = find_line(lines, "G53G1X-204.000Y-728.000F4000.000", unload_pocket + 1);
+    size_t tlo_capture       = find_line(lines, "#<_openatc_tlo_z>=[#5063-#<_openatc_reference_z>]");
+    size_t apply_tlo         = find_line(lines, "G43.1Z#<_openatc_tlo_z>");
+
+    ASSERT_NE(reference_capture, lines.size());
+    ASSERT_NE(first_unload, lines.size());
+    ASSERT_NE(unload_pocket, lines.size());
+    ASSERT_NE(load_pocket, lines.size());
+    ASSERT_NE(tlo_capture, lines.size());
+    ASSERT_NE(apply_tlo, lines.size());
+    EXPECT_LT(reference_capture, first_unload);
+    EXPECT_LT(unload_pocket, load_pocket);
+    EXPECT_LT(load_pocket, tlo_capture);
+    EXPECT_LT(tlo_capture, apply_tlo);
+}
+
