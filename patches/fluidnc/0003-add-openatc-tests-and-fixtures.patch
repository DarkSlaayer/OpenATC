+TEST(OpenATCJobChannel, UpdatesFinishedToolOnlyAfterEof) {
+    std::vector<float> first { -280.0f, -728.0f };
+    std::vector<float> toolsetter { -24.0f, -784.0f, -130.0f };
+    OpenATCActionConfig load = action();
+    OpenATCActionConfig unload = action();
+    OpenATCConfigView cfg = valid_config(first, toolsetter, load, unload);
+    OpenATCChangePlan plan = openatc_build_change_plan(1, 2, true);
+
+    OpenATCJobTestResult result = openatc_run_job_channel_for_test(cfg, plan, X_AXIS, 1, 2, false, {});
+
+    EXPECT_TRUE(result.finished);
+    EXPECT_EQ(result.finished_tool, 2);
+    EXPECT_FALSE(result.failed);
+}
+
+TEST(OpenATCJobChannel, RestoresInchModeOnSuccess) {
+    std::vector<float> first { -280.0f, -728.0f };
+    std::vector<float> toolsetter { -24.0f, -784.0f, -130.0f };
+    OpenATCActionConfig load = action();
+    OpenATCActionConfig unload = action();
+    OpenATCConfigView cfg = valid_config(first, toolsetter, load, unload);
+    OpenATCChangePlan plan = openatc_build_change_plan(0, 1, true);
+
+    OpenATCJobTestResult result = openatc_run_job_channel_for_test(cfg, plan, X_AXIS, 0, 1, true, {});
+
+    ASSERT_FALSE(result.emitted_lines.empty());
+    EXPECT_EQ(result.emitted_lines.front(), "G21");
+    EXPECT_EQ(result.emitted_lines.back(), "G20");
+    EXPECT_TRUE(result.finished);
+}
+
+TEST(OpenATCJobChannel, RestoresInchModeBeforeSensorFailure) {
+    std::vector<float> first { -280.0f, -728.0f };
+    std::vector<float> toolsetter { -24.0f, -784.0f, -130.0f };
+    OpenATCActionConfig load = action();
+    OpenATCActionConfig unload = action();
+    OpenATCConfigView cfg = valid_config(first, toolsetter, load, unload);
+    OpenATCChangePlan plan = openatc_build_change_plan(0, 1, true);
+    OpenATCSensorSnapshot failed_load;
+    failed_load.tool_in_spindle_defined = true;
+    failed_load.tool_in_spindle = false;
+
+    OpenATCJobTestResult result = openatc_run_job_channel_for_test(cfg, plan, X_AXIS, 0, 1, true, { failed_load });
+
+    ASSERT_FALSE(result.emitted_lines.empty());
+    EXPECT_EQ(result.emitted_lines.front(), "G21");
+    EXPECT_EQ(result.emitted_lines.back(), "G20");
+    EXPECT_FALSE(result.finished);
+    EXPECT_TRUE(result.failed);
+    EXPECT_EQ(result.failure_count, 1u);
+}
